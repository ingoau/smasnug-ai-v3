OPENROUTER_KEY=
DATABASE_URL=postgres://smasnug:smasnug@localhost:5433/smasnug
REDIS_URL=redis://localhost:6380
# Slack (Socket Mode)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...
# Moderation / admin
MOD_CHANNEL_ID=C...
ADMIN_USER_ID=U...
# Emoji search
SEMOJI_URL=https://emojis.raygen.dev
SEMOJI_KEY=
# Web search (Exa, https://exa.ai). Without it, web_search answers "not configured".
EXA_API_KEY=
# Hack Club AI (https://ai.hackclub.com): primary chat provider when set; OpenRouter is the fallback
HACKCLUB_AI_KEY=
# Models (OpenRouter ids)
MODEL_LUNA=openai/gpt-6-luna
# Relevance gate: decisions model via OpenRouter's Decisions API ('luna' = use MODEL_LUNA via chat)
GATE_MODEL=typesafe/jev-1.13
GATE_THRESHOLD=0.8
BOT_DISPLAY_NAME=smasnug ai
LOG_LEVEL=info
# Turn activity text: tasks (transient task cards in the reply message, next to Slack's "Working…") | off ("Working…" only)
# STATUS_ACTIVITY_MODE=tasks
# Coding agents (Cursor Cloud Agents API, https://cursor.com/docs/cloud-agent/api/endpoints): the admin
# (ADMIN_USER_ID) can ask the bot to change its own code; a Cursor agent works on CURSOR_REPO and opens a PR.
# Off unless CURSOR_API_KEY and CURSOR_REPO are set. Key: Cursor Dashboard -> API Keys.
# CURSOR_API_KEY=crsr_...
# CURSOR_REPO=https://github.com/ingoau/smasnug-ai-v3
# Base branch the agent starts from / the PR targets (default main)
# CURSOR_REF=main
# Cursor model id (GET /v1/models); unset = the account's default model
# CURSOR_MODEL=
# CURSOR_API_URL=https://api.cursor.com
# Optional read-only GitHub token so the post-run check can list a private repo's PR files (flags .github/workflows changes)
# CURSOR_GITHUB_TOKEN=
# HuddleFM DJ mode (https://github.com/ingoau/huddlefm/blob/main/docs/bot-api.md): the HuddleFM bot user's Slack id.
# This app's bot user id must be in HuddleFM's INTEGRATION_USER_IDS. Unset = no DJ tools.
# HUDDLEFM_USER_ID=U...
# Code sandboxes (Modal Sandboxes, docs/sandbox.md): subagents spawned with `sandbox: true` run code there.
# Off (no tools, jobs or App Home section) unless MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are set. Build the images once
# per environment with `pnpm sandbox:images` before enabling.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...
# MODAL_ENVIRONMENT=smasnug-prod
# MODAL_APP_NAME=smasnug-sandbox
# Hard stop for this deployment's estimated monthly sandbox spend (USD). Dev and prod share Modal's $30/month credit:
# e.g. dev 5, prod 20. SANDBOX_WORKSPACE_CREDIT_USD stops everything when Modal's whole-workspace cost reaches it.
# SANDBOX_MONTHLY_BUDGET_USD=20
# SANDBOX_WORKSPACE_CREDIT_USD=28
# Extra egress deny list (comma-separated IPv4 CIDRs/IPs), e.g. our own hosts' public addresses
# SANDBOX_EGRESS_DENY=
# Live previews (Cloudflare temporary deploys): 32-byte key, base64 (`openssl rand -base64 32`). Unset = no previews.
# PREVIEW_SECRET_KEY=
# PREVIEW_TERMS_VERSION=cf-2025-10
# WRANGLER_VERSION=4.148.0
# HCA_URL=https://auth.hackclub.com
