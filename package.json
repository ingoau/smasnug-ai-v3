{
  "name": "smasnug-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ingress": "tsx watch --env-file=.env src/ingress/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker/main.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "simulate": "SLACK_FAKE=1 tsx --env-file=.env scripts/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "ai": "^7.0.127",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
