{
  "name": "smasnug-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ingress": "tsx watch --env-file=.env src/ingress/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start:ingress": "node dist/ingress/main.js",
    "start:worker": "node dist/worker/main.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "bench": "tsx scripts/bench.ts",
    "simulate": "SLACK_FAKE=1 tsx --env-file=.env scripts/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "ai": "^7.0.127",
    "bullmq": "^6.3.11",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "request-filtering-agent": "^3.2.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.3"
}
