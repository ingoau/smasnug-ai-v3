{
  "name": "smasnug-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ingress": "tsx watch --env-file=.env src/ingress/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start:ingress": "node dist/ingress/main.js",
    "start:worker": "node dist/worker/main.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "bench": "tsx scripts/bench.ts",
    "eval:export": "tsx --env-file=.env scripts/eval-export.ts",
    "simulate": "SLACK_FAKE=1 tsx --env-file=.env scripts/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "sandbox:images": "tsx --env-file=.env scripts/sandbox-images.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.4.0",
    "ai": "^7.0.173",
    "bullmq": "^6.7.6",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "modal": "0.11.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "request-filtering-agent": "^3.2.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "undici": "^7.30.2",
      "zod": "^4.6.7",
      "vite": "^8.3.3"
    }
  }
}
